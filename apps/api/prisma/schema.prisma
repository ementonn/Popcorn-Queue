generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Job {
  id              String   @id
  state           String
  phase           String
  sourceJson      String   @map("source")
  candidateJson   String?  @map("candidate")
  checkResultJson String?  @map("check_result")
  torrentJson     String?  @map("torrent")
  uploadReadiness String   @default("missing_evidence") @map("upload_readiness")
  humanStep       String   @default("Preparing upload package") @map("human_step")
  artifactsJson   String   @default("{}") @map("artifacts")
  reviewDraftJson String?  @map("review_draft")
  workspaceJson   String?  @map("workspace")
  downloadStatusJson String? @map("download_status")
  uploadPlanJson  String   @map("upload_plan")
  phasesJson      String   @map("phases")
  eventsJson      String   @map("events")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdAt])
}

model PtpCacheEntry {
  key       String   @id
  dataJson  String   @map("data")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
