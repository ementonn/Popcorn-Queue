# Popcorn Queue local service
POPCORN_QUEUE_HOST=0.0.0.0
POPCORN_QUEUE_PORT=3500
POPCORN_QUEUE_WEB_URL=http://127.0.0.1:5173
POPCORN_QUEUE_API_URL=http://127.0.0.1:3500
POPCORN_QUEUE_BROWSER_TOKEN=change-me
POPCORN_QUEUE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:3500
VITE_POPCORN_QUEUE_API_URL=http://127.0.0.1:3500

# Persistence and workspace
DATABASE_URL=file:./popcorn-queue.db
POPCORN_QUEUE_DATA_ROOT=./data
POPCORN_QUEUE_WORK_DIR=./data/work
POPCORN_QUEUE_OUTPUT_DIR=./data/output

# Logs
POPCORN_QUEUE_LOG_LEVEL=info
POPCORN_QUEUE_LOG_TO_FILE=true
POPCORN_QUEUE_LOG_TO_CONSOLE=true
POPCORN_QUEUE_LOG_FILE=logs/api.log
POPCORN_QUEUE_WORKER_LOG_FILE=logs/worker.log

# PTP duplicate checker and future uploader login
PTP_API_USER=
PTP_API_KEY=
PTP_USERNAME=
PTP_PASSWORD=
PTP_BASE_URL=https://passthepopcorn.me/torrents.php
PTP_USER_AGENT=Popcorn Queue/0.1
PTP_REQUEST_DELAY_MS=2000
PTP_ANNOUNCE_URL=
PTP_COOKIE_FILE=

# Optional provider and upload integrations
POPCORN_QUEUE_IMAGE_HOST=imgbb
IMGBB_API_KEY=
TMDB_API_KEY=
PTPIMG_API_KEY=
QBITTORRENT_URL=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
QBITTORRENT_TAGS=ptp,upload
QBITTORRENT_CATEGORY=
QBITTORRENT_CONTENT_LAYOUT=Original

# Worker tools are disabled by default so tests and dry runs do not execute
# external commands. Set this to true only for manual media processing tests.
POPCORN_QUEUE_RUN_EXTERNAL_TOOLS=false
FFMPEG_BIN=ffmpeg
MEDIAINFO_BIN=mediainfo
OXIPNG_BIN=oxipng
