# Popcorn Queue local service
POPCORN_QUEUE_HOST=0.0.0.0
POPCORN_QUEUE_PORT=3500
POPCORN_QUEUE_WEB_PORT=5173
POPCORN_QUEUE_PUBLIC_SCHEME=http
POPCORN_QUEUE_PUBLIC_HOST=localhost
# `npm run configure` can generate this token for you.
POPCORN_QUEUE_BROWSER_TOKEN=change-me
POPCORN_QUEUE_WEB_AUTH=true
POPCORN_QUEUE_WEB_AUTH_COOKIE=popcorn_session
POPCORN_QUEUE_WEB_AUTH_MAX_AGE_SECONDS=604800

# Persistence and workspace
DATABASE_URL=file:./popcorn-queue.db
POPCORN_QUEUE_DATA_ROOT=./data
POPCORN_QUEUE_WORK_DIR=./data/work
POPCORN_QUEUE_OUTPUT_DIR=./data/output

# Logs
POPCORN_QUEUE_LOG_LEVEL=info
POPCORN_QUEUE_LOG_TO_FILE=true
POPCORN_QUEUE_LOG_TO_CONSOLE=true
POPCORN_QUEUE_LOG_FILE=logs/api.log
POPCORN_QUEUE_WORKER_LOG_FILE=logs/worker.log

# PTP duplicate checker and uploader login
PTP_API_USER=
PTP_API_KEY=
PTP_USERNAME=
PTP_PASSWORD=
PTP_BASE_URL=https://passthepopcorn.me/torrents.php
PTP_USER_AGENT=Popcorn Queue/0.1
PTP_REQUEST_DELAY_MS=2000
PTP_ANNOUNCE_URL=
PTP_COOKIE_FILE=./data/ptp-cookies.txt

# Optional provider and upload integrations
POPCORN_QUEUE_IMAGE_HOST=imgbb
IMGBB_API_KEY=
TMDB_API_KEY=
PTPIMG_API_KEY=
QBITTORRENT_URL=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
QBITTORRENT_TAGS=ptp,upload
QBITTORRENT_CATEGORY=
QBITTORRENT_CONTENT_LAYOUT=Original
QBITTORRENT_DOWNLOAD_WAIT_MS=21600000
QBITTORRENT_DOWNLOAD_POLL_MS=15000

# Worker tools are enabled by default for normal upload preparation. Set this
# to false only for dry runs where ffmpeg, MediaInfo, mkvmerge, and oxipng
# should be skipped or mocked.
POPCORN_QUEUE_RUN_EXTERNAL_TOOLS=true
FFMPEG_BIN=ffmpeg
MEDIAINFO_BIN=mediainfo
MKVMERGE_BIN=mkvmerge
MPV_BIN=mpv
OXIPNG_BIN=oxipng
XVFB_RUN_BIN=xvfb-run
